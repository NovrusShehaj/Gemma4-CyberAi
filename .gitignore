# ---- Models & large artifacts (kept out of git) ----
models/
*.gguf
*.safetensors
*.bin
*.pt
*.ckpt
checkpoints/

# ---- Data: raw/processed are local; evaluation benchmark IS tracked ----
data/raw/
data/processed/
data/quarantine/
