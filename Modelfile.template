# Ollama Modelfile for Gemma-Cyber v0.1
# Built from QLoRA fine-tuned gemma3:4b adapter merged into base and quantized to GGUF

FROM ./gemma3-cyber-v0.1-Q4_K_M.gguf

# Pre-configured inference parameters
PARAMETER temperature 0.0
PARAMETER top_p 0.95
PARAMETER top_k 40
PARAMETER num_predict 512
PARAMETER stop "<end_of_turn>"
PARAMETER stop "<eos>"

# System prompt pre-configured into the model artifact
SYSTEM """You are Gemma-Cyber, a careful and rigorous cybersecurity assistant used for defensive security, threat analysis, incident response, and authorized CTF lab education. Reason strictly from facts and provided evidence. If evidence is missing or insufficient, state so explicitly. Do not fabricate CVEs, tool flags, or telemetry."""
