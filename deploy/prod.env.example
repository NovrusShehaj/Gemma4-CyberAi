# Copy this file, fill in real values, chmod 0600, and do not commit it.
# Used with: docker compose -f docker-compose.yml -f docker-compose.prod.yml
#
# SPA client id is public (PKCE, no secret). Domain/audience are not credentials
# but they identify your tenant — treat the filled file as operator config.

GEMMA_CYBER_AUTH_DOMAIN=your-tenant.auth0.com
GEMMA_CYBER_AUTH_AUDIENCE=https://api.gemma-cyber
GEMMA_CYBER_WEB_AUTH0_CLIENT_ID=your-spa-client-id
GEMMA_CYBER_CORS_ORIGINS=https://REPLACE_WITH_PUBLIC_ORIGIN
GEMMA_CYBER_MODEL=gemma3:4b
GEMMA_CYBER_RATE_LIMIT_PER_MIN=60
